<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon for these. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="scan_qr"
        android:shortcutLongLabel="@string/shortcut_scan_qr_long"
        android:shortcutShortLabel="@string/shortcut_scan_qr">
        <intent
            android:action="ai.guardian.action.SCAN_QR"
            android:targetClass="ai.guardian.MainActivity"
            android:targetPackage="ai.guardian" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="check_copied"
        android:shortcutLongLabel="@string/shortcut_check_copied_long"
        android:shortcutShortLabel="@string/shortcut_check_copied">
        <intent
            android:action="ai.guardian.action.CHECK_CLIPBOARD"
            android:targetClass="ai.guardian.MainActivity"
            android:targetPackage="ai.guardian" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="check_message"
        android:shortcutLongLabel="@string/shortcut_check_message_long"
        android:shortcutShortLabel="@string/shortcut_check_message">
        <intent
            android:action="ai.guardian.action.CHECK_MESSAGE"
            android:targetClass="ai.guardian.MainActivity"
            android:targetPackage="ai.guardian" />
    </shortcut>
</shortcuts>
